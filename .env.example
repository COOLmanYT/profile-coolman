# Public identity, appearance, feature availability and provider IDs: site.config.json
# This file is a template. Store real secrets in .env.local / hosting environment.
# Fill only the integrations enabled in your configuration. No original-site keys are shared.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Your owner Discord ID controls both dashboard access and Lanyard presence.
DISCORD_USER_ID=
DISCORD_BOT_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_DEBUG=false
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional override of providers.twitch.login; keep both aligned.
TWITCH_BROADCASTER_LOGIN=
TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/callback
TWITCH_REFRESH_TOKEN=
# Optional server-only keys; public data has credential-free fallbacks.
YOUTUBE_API_KEY=
GITHUB_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional deployment overrides of site.url / site.contactEmail.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
